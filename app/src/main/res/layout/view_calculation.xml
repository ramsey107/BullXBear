<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:ndroid="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:backgroundTint="#CCCCCC"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp"
        android:layout_margin="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/totalCV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Value*"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/totalCVAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹739,392"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/totalIV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Investment*"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalCV"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/totalIVAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹650,000"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalCVAmount"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/todayPNLValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Profit and Loss*"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalIV"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/todayPNLAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹12,000"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/totalIVAmount"
                android:layout_marginTop="8dp"/>

            <View
                android:id="@+id/separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/todayPNLAmount"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/PNLValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profit and Loss*"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/separator"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/PNLAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹89,392"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/separator"
                android:layout_marginTop="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>